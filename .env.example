# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime for self-referential links, OAuth callbacks, and PayPal return URLs.
APP_URL="MY_APP_URL"

# PAYPAL SANDBOX CREDENTIALS:
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""

# FREELANCER_EMAIL: PayPal sandbox email of the freelancer to receive released escrow payouts
FREELANCER_EMAIL=""


